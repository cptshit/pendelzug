# .gitignore – Dateien, die git NICHT ins Repository übernehmen soll.

# Build-Ergebnisse (entstehen bei jedem „pebble build“ neu)
build/
.lock-waf*
*.pbw

# Node.js-Pakete (werden bei Bedarf neu installiert)
node_modules/

# Python-Zwischendateien
__pycache__/
*.pyc

# Lokale Konfiguration und Zugangsdaten – NIEMALS ins Repo!
# (z. B. später Geofox-Benutzer/Passwort zum Testen)
.env
.env.*
*.local.js
*.local.json
config.local.*
secrets*
# Geofox-Zugangsdaten, falls jemand die Datei aus dem Home-Verzeichnis
# versehentlich ins Projekt kopiert, und weitere typische Schlüsseldateien
.pendelzug-gti*
*gti-zugang*
credentials*
*.pem
*.key

# Editor- und Systemdateien
.vscode/
.idea/
*.swp
*~
.DS_Store

# Arbeitsanweisungen für Claude Code – bleiben nur lokal
CLAUDE.md

# Rohantworten der GTI-Testskripte (tools/gti-route.js) – nur zum Ansehen
tools/ausgabe/

# Server: Zugangsdaten und Zwischenspeicher (nur auf dem Webspace bzw. lokal)
pendelzug-privat/
server/daten/
